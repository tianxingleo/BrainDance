            print(f"\n🎉 成功！模型已保存: {final_output_path}")
        else:
            print("    ❌ 失败: 未生成 PLY 文件")
            
    except Exception as e:
        print(f"\n❌ 运行出错: {e}")
        import traceback
        traceback.print_exc()

    print(f"\n📊 总耗时: {format_duration(time.time() - global_start_time)}")

if __name__ == "__main__":
    run_pipeline()
