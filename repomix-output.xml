```
import numpy as np
import cv2
import torch
from pathlib import Path
from ultralytics import YOLOWorld, SAM

class AutoMasker:
    def __init__(self, device='cuda'):
        print("🧠 [AI 初始化] 正在加载 YOLO-World 和 SAM 模型 (首次运行会自动下载)...")
        self.device = device
        
        # 1. 加载 YOLO-World (负责听懂文字，找到方框)
        # yolov8s-worldv2.pt 比较小，yolov8x-worldv2.pt 更准。5070 建议直接上 x 版本。
        self.detector = YOLOWorld('yolov8x-worldv2.pt') 
        
        # 2. 加载 SAM (负责根据方框，精细抠图)
        # sam_b.pt (base) 速度快, sam_l.pt (large) 精度高。5070 建议用 sam_l.pt
        self.segmentor = SAM('sam_l.pt') 
        
        print("✅ 模型加载完毕！")

    def predict_mask(self, image_path, prompt_text):
        """
        输入: 图片路径, 提示词 (例如 "black shoes", "anime figure")
        输出: 蒙版 (numpy array, 0=背景, 255=物体)
        """
        try:
            # --- 步骤 1: 使用 YOLO-World 寻找物体 (Text -> Box) ---
            # 设置我们要找的类别
            self.detector.set_classes([prompt_text])
            
            # 推理，conf=0.1 降低门槛防止漏检
            det_results = self.detector.predict(image_path, conf=0.1, verbose=False)
            
            if len(det_results[0].boxes) == 0:
                print(f"⚠️ 未找到物体: '{prompt_text}'")
                return None
            
            # 获取所有检测到的方框 (xyxy 格式)
            bboxes = det_results[0].boxes.xyxy
            
            # --- 步骤 2: 将方框传给 SAM 进行分割 (Box -> Mask) ---
            # SAM 在 ultralytics 中可以直接接受检测器的结果，或者我们手动传框
            # 这里我们使用手动传框的方式确保逻辑清晰
            
            sam_results = self.segmentor(image_path, bboxes=bboxes, verbose=False)
            
            if len(sam_results[0].masks) == 0:
                return None

            # --- 步骤 3: 合并蒙版 ---
            # 可能会检测到多个部件（比如两只鞋），我们需要把它们合并成一张图
            final_mask = np.zeros(sam_results[0].orig_shape[:2], dtype=np.uint8)
            
            # 提取 Mask 数据 (ultralytics 返回的是 Tensor)
            masks = sam_results[0].masks.data.cpu().numpy() # shape: [N, H, W]
            
            for mask in masks:
                # 转换 float mask 到 uint8 (0 or 255)
                mask_uint8 = (mask * 255).astype(np.uint8)
                # 调整尺寸以防万一 (SAM 输出有时会缩放)
                if mask_uint8.shape != final_mask.shape:
                     mask_uint8 = cv2.resize(mask_uint8, (final_mask.shape[1], final_mask.shape[0]))
                
                # 取并集 (Or 操作)
                final_mask = cv2.bitwise_or(final_mask, mask_uint8)
                
            return final_mask

        except Exception as e:
            print(f"❌ 语义抠图出错: {e}")
            return None

# ================== 测试代码 ==================
if __name__ == "__main__":
    # 假设有一张鞋子的照片
    img_path = "test_shoe.jpg" 
    
    # 初始化 (只需做一次，放在内存里)
    masker = AutoMasker()
    
    # 假设 GPT-4o 告诉你这里面是 "white sneakers"
    mask = masker.predict_mask(img_path, "white sneakers")
    
    if mask is not None:
        cv2.imwrite("output_mask.png", mask)
        print("🎉 蒙版生成成功！")
