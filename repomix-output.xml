        "ns-export", "gaussian-splat",
        "--load-config", str(config_path),
        "--output-dir", str(work_dir)
    ]
    
    # 只需要运行 CLI 命令，避免 Python 内部复杂调用
    subprocess.run(cmd_export, check=True, env=env)
    
    print("⏳ 等待文件写入磁盘...")
