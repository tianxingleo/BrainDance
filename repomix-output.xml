    valid_frames_list = [] # 存放合格的帧数据
    deleted_count = 0
    
    print(f"    -> 开始处理 {total_imgs} 张图片...")

    for i, img_path in enumerate(image_files):
        # --- A. 检测与分割 (同前) ---
