    # 关键修改：
    # -vf "fps=2,scale=1600:-1": 每秒抽2帧，且把宽度缩放到1600像素
    !ffmpeg -i {VIDEO_PATH} -vf "fps=2,scale=1600:-1" -qscale:v 1 -qmin 1 -qmax 1 {PROJECT_PATH}/input/%04d.jpg -hide_banner -loglevel error
    
    # 检查生成了多少张
