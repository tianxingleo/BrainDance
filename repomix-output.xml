        # 1. 使用 PIL 读取图片
        pil_image = Image.open(str(target_img_path)).convert("RGB")
        orig_w, orig_h = pil_image.size
        print(f"       原始尺寸: {orig_w} x {orig_h}")

        # 2. 强制缩小到 512x512 (或者更小，如 384x384)
        # 这能成倍地减少显存占用，解决 OOM 和 TDR 问题
