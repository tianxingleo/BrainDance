    if not transforms_file.exists():
        print("⚠️ 未找到 transforms.json，无法进行 Mask 处理。")
        return False

    # ================= 核心修改逻辑开始 =================
    print(f"\n✂️ [AI 分割] 正在初始化...")

    # --- 第一层：尝试调用大模型获取精准 Prompt ---
    text_prompt = None
