        print(process_result.stdout)
        
        if "COLMAP only found poses" in process_result.stdout:
             raise RuntimeError("COLMAP 失败，特征点不足。")

    # ================= [Step 2] 模型训练 (含智能参数) =================
    search_path = output_dir / project_name / "splatfacto"
