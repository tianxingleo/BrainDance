        print(f"    🎉 成功！模型已保存: {final_windows_path}")
    else:
        print("    ❌ 失败: 未生成 PLY 文件")

    print(f"\n📊 总耗时: {format_duration(time.time() - global_start_time)}")

if __name__ == "__main__":
