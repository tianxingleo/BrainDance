    mock_kaolin.ops.mesh.check_sign = mock_func
    mock_kaolin.ops.mesh.sample_points = mock_func
    
    # metrics
    mock_kaolin.metrics.pointcloud.chamfer_distance = mock_func
    
    # visualize
