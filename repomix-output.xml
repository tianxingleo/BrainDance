import cv2
import shutil
import numpy as np
from pathlib import Path

def fast_filter_blurry_images(image_folder, threshold=80.0):
    print(f"🚀 [极速清洗] 正在使用 Laplacian 方差过滤模糊图片 (阈值: {threshold})...")
