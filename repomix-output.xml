### 🚀 最终版代码：自适应空间裁剪 (V8.0)

这份代码**移除了**可能导致多物体丢失的 AI 蒙版功能，转而使用**极高精度的数学计算**来设定训练边界。

**特点：**

- ✅ **多物体友好**：鞋子、水杯、书本全保留。
- ✅ **去背景**：自动计算背景墙的距离并切除。
- ✅ **无需显卡 AI**：纯数学计算，任何电脑都能跑。

codePython



```
import subprocess
import sys
import shutil
import os
import time
import json
import logging
import numpy as np
from pathlib import Path

# ================= 🔧 配置 =================
LINUX_WORK_ROOT = Path.home() / "braindance_workspace"
# 场景半径系数：越大保留范围越广，越小去背景越狠
# 对于多物体场景，建议 1.5 ~ 2.0，能包住整个桌面的物体
SCENE_RADIUS_SCALE = 1.8 

logging.getLogger('nerfstudio').setLevel(logging.ERROR)

# ================= 📐 核心算法：自适应空间计算 =================

def calculate_adaptive_collider(json_path):
    """
    读取 transforms.json，根据相机分布自动计算最佳裁剪范围。
    原理：ns-process-data 会自动将主体归一化到 (0,0,0)。
    我们只需要计算相机层到原点的距离，就能把原本点夹在中间。
    """
    print(f"\n📐 [几何计算] 正在分析场景空间结构...")
    
    try:
        with open(json_path, 'r') as f:
            data = json.load(f)
        
        frames = data["frames"]
        if not frames: return None

        # 1. 提取所有相机到原点 (0,0,0) 的距离
        # 注意：Nerfstudio 的坐标系中，主体通常已经被放在了 (0,0,0)
        distances = []
        for frame in frames:
            c2w = np.array(frame["transform_matrix"])
            pos = c2w[:3, 3] # 相机位置 x,y,z
            dist = np.linalg.norm(pos) # 到原点的距离
            distances.append(dist)
        
        distances = np.array(distances)
        
        # 2. 统计学分析
        avg_dist = np.mean(distances)
        min_dist = np.min(distances)
        
        print(f"    -> 相机平均距离: {avg_dist:.2f}")
        print(f"    -> 相机最近距离: {min_dist:.2f}")
        
        # 3. 计算裁剪平面
        # 我们假设物体在原点，半径约为 1.0 (Nerfstudio 标准化特性)
        # 近平面：相机前面一点点就开始渲染 (防止切掉近处的物体边缘)
        # 远平面：穿过物体后一点点就停止 (防止渲染背景墙)
        
        # 逻辑：
        # near = 距离 - 场景半径 (如果结果太小，取 0.05)
        # far  = 距离 + 场景半径
        
        scene_radius = 1.0 * SCENE_RADIUS_SCALE
        
        # 我们使用最近的相机距离来保守计算 near，防止贴脸拍摄时物体被切
        calc_near = max(0.05, min_dist - scene_radius)
        
        # 我们使用平均距离来计算 far，保证背景被切掉
        calc_far = avg_dist + scene_radius
        
        print(f"💡 [自适应策略] 裁剪范围: Near={calc_near:.2f}, Far={calc_far:.2f}")
        print(f"    -> 这将保留中心区域半径约 {scene_radius} 的内容，同时切除远处背景。")
        
        return ["--pipeline.model.enable-collider", "True", 
                "--pipeline.model.collider-params", "near_plane", str(round(calc_near, 2)), 
                "far_plane", str(round(calc_far, 2))]

    except Exception as e:
        print(f"⚠️ 计算失败 ({e})，使用默认参数。")
        return ["--pipeline.model.enable-collider", "True", 
                "--pipeline.model.collider-params", "near_plane", "0.5", "far_plane", "4.0"]

