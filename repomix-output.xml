    return str(datetime.timedelta(seconds=int(seconds)))

def run_pipeline():
    global_start_time = time.time()
    
    current_dir = Path(__file__).resolve().parent
    source_png_path = current_dir / "input.png"
    source_jpg_path = current_dir / INPUT_IMAGE_NAME
    
