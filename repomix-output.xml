        # 2. 转为灰度图 (模糊检测不需要色彩)
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

        # 3. 核心算法: 计算拉普拉斯算子的方差
        # 结果越小 = 越模糊; 结果越大 = 边缘越锐利
        score = cv2.Laplacian(gray, cv2.CV_64F).var()
        scores.append(score)

