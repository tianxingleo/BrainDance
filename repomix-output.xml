    except Exception as e:
        # 如果中间崩了，也要告诉 Go
        send_to_go(task_id, "error", 0, f"发生错误: {str(e)}")
        # 出错时也可以选择清理，防止垃圾堆积
        cleanup_workspace(project_name)
