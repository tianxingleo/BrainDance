import subprocess
import os
import sys
import shutil
import requests
from pathlib import Path

# ================= 配置 =================
# 你的工作空间
WORKSPACE_ROOT = Path("./user_data") 
OUTPUT_DIR = Path("./output")
CALLBACK_URL = "http://127.0.0.1:8080/api/task/update"

