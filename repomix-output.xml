        # 复制视频到 Linux 高速区
        video_dst = work_dir / video_src.name
        shutil.copy(str(video_src), str(video_dst))

        # ================= [Step 1] 数据预处理 (Manual Split) =================
        print(f"\n🎥 [1/3] 视频抽帧与位姿解算 (COLMAP)")
        
