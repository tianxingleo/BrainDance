                int(np.log2(self.resolution)),
                dtype=torch.uint8,
                device="cuda",
            )
            for k, v in self.layout.items():
                setattr(
                    representation,
                    k,
                    x.feats[x.layout[i]][:, v["range"][0] : v["range"][1]].reshape(
                        -1, *v["shape"]
                    ),
                )
            representation.trivec = representation.trivec + 1
            ret.append(representation)
        return ret

