import os
import sys
import shutil
import time
import datetime
from pathlib import Path
import logging
import torch
import torch.nn.functional as F
from types import ModuleType
import numpy as np

# ================= 🔥 [RTX 5070 兼容性补丁 V31] 终极伪造 (修复链式调用逻辑) 🔥 =================
def inject_mocks():
    print("⚠️ [系统检测] 正在注入 Kaolin 和 PyTorch3D 的 V31 Mock 模块...")

    device = 'cuda' if torch.cuda.is_available() else 'cpu'

    # --- 1. 定义智能 Mock 类 ---
    class MockClass:
        def __init__(self, *args, **kwargs): 
            self.device = device
        
        # 场景 A: 直接调用 t(points) -> 返回 Tensor
        def __call__(self, *args, **kwargs): 
            return torch.zeros(1, 3, device=device, requires_grad=True)
        
        # 场景 B: 显式转换方法 -> 返回 self (支持链式调用)
        def compose(self, *args, **kwargs): return self
        def inverse(self): return self
        def to(self, *args, **kwargs): return self
        def cpu(self): return self
        def cuda(self): return self
        def clone(self): return self
        def detach(self): return self
        
        # 场景 C: 显式计算方法 -> 返回 Tensor
        def get_matrix(self): return torch.eye(4, device=device).unsqueeze(0)
        def transform_points(self, x): return x # 返回输入本身或全零
        def transform_normals(self, x): return x
        
        # 场景 D: 未知属性/方法 (关键修复)
        def __getattr__(self, name):
            # 这是一个闭包，用来捕获任何未定义的方法调用 (如 rotate, translate, scale)
            # 并强制它们返回 self，而不是 Tensor，从而维持对象类型
            def method_mock(*args, **kwargs):
                return self
            return method_mock

    def mock_func(*args, **kwargs): 
        return torch.tensor(0.0, device=device)
    
    def mock_check_func(*args, **kwargs):
        return False 

