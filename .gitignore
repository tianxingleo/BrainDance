/app/ios/Flutter/flutter_export_environment.sh
/app/ios/Pods/
/app/ios/Podfile.lock

# =========================
# 5. AI Engine: Python (算法端)
# =========================
# 字节码与缓存
ai_engine/**/__pycache__/
ai_engine/**/*.pyc

# 虚拟环境 (兼容常见的命名)
ai_engine/venv/
ai_engine/.venv/
ai_engine/env/

# Jupyter Notebook 缓存
ai_engine/.ipynb_checkpoints

# Qwen3 fine-tuning artifacts
# Generated logs and training outputs. If you want to publish an adapter,
# export a clean release bundle under ai_engine/finetune_qwen3/releases/;
# *.safetensors is already covered by Git LFS in the repo root .gitattributes.
ai_engine/finetune_qwen3/logs/
ai_engine/finetune_qwen3/outputs/
# Generated datasets; rebuild via scripts/build_*dataset.py.
# Keep benchmark/seed/template inputs versioned in normal Git for regression tracking.
ai_engine/finetune_qwen3/data/braindance_qwen3_sft_train.jsonl
ai_engine/finetune_qwen3/data/braindance_qwen3_sft_val.jsonl
ai_engine/finetune_qwen3/data/braindance_qwen3_sft_manifest.json
ai_engine/finetune_qwen3/data/braindance_qwen3_round4_train.jsonl
ai_engine/finetune_qwen3/data/braindance_qwen3_round4_val.jsonl
ai_engine/finetune_qwen3/data/braindance_qwen3_round4_manifest.json
ai_engine/finetune_qwen3/data/real_chain_failures_round4_patch.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_patch_train.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_patch_val.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_1_patch.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_1_patch_train.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_1_patch_val.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_1_patch_manifest.json
ai_engine/finetune_qwen3/data/real_chain_failures_round4_1_patch_plus_round4_train.jsonl
ai_engine/finetune_qwen3/data/real_chain_failures_round4_1_patch_plus_round4_val.jsonl

# =========================
# 6. BrainDance Specific: Media & 3DGS Data (项目特有)
# =========================
# 忽略 ai_engine 下的所有大型媒体文件 (无论在哪个子目录)
ai_engine/**/*.mp4
ai_engine/**/*.mov
ai_engine/**/*.avi
ai_engine/**/*.mkv
ai_engine/**/*.jpg
ai_engine/**/*.jpeg
ai_engine/**/*.png
ai_engine/**/*.gif

# 忽略 3DGS 训练过程中的大型模型文件
ai_engine/**/*.ply
ai_engine/**/*.splat
ai_engine/**/*.obj
ai_engine/**/*.glb
ai_engine/**/*.gltf

# 忽略 app/assets/webgl/models 下的模型文件
app/assets/webgl/models/*.ply
app/assets/webgl/models/*.splat
app/assets/webgl/models/*.obj
app/assets/webgl/models/*.glb
app/assets/webgl/models/*.gltf
# 忽略 app/assets/webgl/models 下的图片文件
app/assets/webgl/models/images/

# 忽略 3dgs_viewer/ (WebGL Demo) 下的媒体文件
3dgs_viewer/**/*.mp4
3dgs_viewer/**/*.mov
3dgs_viewer/**/*.avi
3dgs_viewer/**/*.ply
3dgs_viewer/**/*.splat
3dgs_viewer/my-3dgs-viewer/public/models/images/
app/assets/webgl/models/images/
app/assets/webgl/models/*.jpg
app/assets/webgl/models/*.jpeg
app/assets/webgl/models/*.png
app/assets/webgl/models/*.gif
app/assets/webgl/models/*.webp

# 忽略 WebGL 构建产物
app/assets/webgl/assets/
app/assets/webgl/dist/
app/assets/webgl/.vite/

# 忽略 Nerfstudio/COLMAP 的输出目录
ai_engine/outputs/
ai_engine/exports/
ai_engine/data_cache/
ai_engine/datasets/
ai_engine/checkpoints/

# 忽略 Colmap 数据库
ai_engine/**/*.db
ai_engine/**/*.bin

# 忽略 Tensorboard 日志
ai_engine/runs/

