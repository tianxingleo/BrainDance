# =========================
/app/build/
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/.pub-cache/
/app/.pub/

# Dart doc 生成的 API 文档
doc/api/

# Flutter web 构建产物
/app/web/build/

# Android 相关
