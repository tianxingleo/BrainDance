# =========================
# 2. Security & Secrets (安全与密钥 - 极其重要!)
# =========================
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
config.yaml
secrets.yaml
# 如果你有存放 Key 的特定 json
key.json
service_account.json

# =========================
# 3. Server: Go (后端)
# =========================
# 编译生成的二进制文件
/server/main
/server/*.exe
/server/*.dll
/server/*.so
/server/*.dylib
/server/bin/

# 测试输出
/server/*.test
/server/*.out

# 依赖 vendor (如果你不使用 Go Modules 的 vendor模式，通常忽略)
/server/vendor/

