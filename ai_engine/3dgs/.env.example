# Secrets
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
SUPABASE_KEY=sb_secret_xxx

# Deployment-specific variables
APP_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
REDIS_URL=redis://localhost:6379/0

# GPU selection
# Physical GPU index to use. 0=first GPU, 1=second GPU.
GPU_INDEX=0

# COLMAP/GLOMAP settings
COLMAP_USE_GPU=1
# Internal local GPU index for COLMAP/GLOMAP.
# Keep this at 0 in normal single-GPU-visible setups; change GPU_INDEX above to pick a different physical GPU.
COLMAP_GPU_INDEX=0
