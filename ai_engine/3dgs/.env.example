# Secrets
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
SUPABASE_KEY=sb_secret_xxx
SUPABASE_BUCKET=braindance-assets
SUPABASE_TABLE=processing_tasks
SUPABASE_WORKER_TABLE=worker_nodes

# Worker 注册 / 心跳 / 集群控制
# 不填时会自动生成 hostname-pid-random 的实例 ID
WORKER_ID=
# 心跳上报间隔（秒）
WORKER_HEARTBEAT_INTERVAL=10
# Dashboard 认定实例在线的超时时间（秒）
WORKER_ONLINE_TIMEOUT_SECONDS=30
# Supervisor 轮询控制表的频率（秒）
WORKER_SUPERVISOR_POLL_INTERVAL=3
# 中断当前任务时，等待子 Worker 优雅退出的宽限时间（秒）
WORKER_INTERRUPT_GRACE_SECONDS=20

# Deployment-specific variables
APP_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
REDIS_URL=redis://localhost:6379/0

# GPU selection
# Physical GPU index to use. 0=first GPU, 1=second GPU.
GPU_INDEX=0

# COLMAP/GLOMAP settings
COLMAP_USE_GPU=1
# Internal local GPU index for COLMAP/GLOMAP.
# Keep this at 0 in normal single-GPU-visible setups; change GPU_INDEX above to pick a different physical GPU.
COLMAP_GPU_INDEX=0
