# --- 基础配置 ---
# 这里需要把当前目录加到路径里
PYTHONPATH=./
APP_ENV=development

# --- 业务配置 (敏感信息留空，让别人填) ---
# 请填入你的 OpenAI Key
OPENAI_API_KEY=
# 阿里云 DashScope Key（用于 Qwen 多模态分析）
DASHSCOPE_API_KEY=
# 视觉模型（用于场景评分与打标）
DASHSCOPE_VL_MODEL=qwen3-vl-plus
# 请填入你的 Redis 地址，默认为本地
REDIS_URL=redis://localhost:6379/0
# 向量数据库路径
CHROMA_DB_PATH=./data_storage

# Supabase（云端任务模式需要）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=sb_secret_xxx
SUPABASE_BUCKET=braindance-assets
SUPABASE_TABLE=processing_tasks

# 训练与质检
TRAINING_ITERATIONS=15000
MAX_IMAGES=300
MIN_QUALITY_SCORE=40

# 解算器选择: glomap | da3
MAPPER_TYPE=glomap
# GPU 选择（0=第一张卡，1=第二张卡）
GPU_INDEX=0
# COLMAP GPU 开关: 1=启用GPU, 0=强制CPU
COLMAP_USE_GPU=1
# COLMAP/GLOMAP 内部 GPU 索引（默认 0；通常配合 CUDA_VISIBLE_DEVICES 使用）
COLMAP_GPU_INDEX=0

# 网络/内存相关（按需修改）
HF_ENDPOINT=https://hf-mirror.com
PYTORCH_ALLOC_CONF=expandable_segments:True

# ===========================================
# SAM3D 模型配置
# ===========================================

# SAM3D 仓库路径（包含 checkpoints 目录）
# 必填：需要先从 HuggingFace 下载模型
# 下载命令:
#   1. pip install "huggingface_hub[cli]"
#   2. huggingface-cli login
#   3. hf download --repo-type model --local-dir checkpoints facebook/sam-3d-objects
#   4. mv checkpoints/checkpoints checkpoints/hf
#
# 申请访问: https://huggingface.co/facebook/sam-3d-objects
# 详细教程: docs/SAM3D_MODEL_SETUP.md
#
# 示例路径：
# Linux: /home/yourname/workspace/ai/sam-3d-objects
# Mac:   /Users/yourname/projects/sam-3d-objects
# 服务器: /data/models/sam-3d-objects
SAM3D_REPO_PATH=/home/ltx/workspace/ai/sam-3d-objects

# 模型检查点目录（通常在 REPO_PATH/checkpoints/hf 下）
# 可选：如果为空，会自动使用 REPO_PATH/checkpoints/hf
SAM3D_CHECKPOINT_DIR=
