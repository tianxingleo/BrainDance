# Git LFS 大文件跟踪配置
# 修复时间: 2026-01-21
# 原则：只跟踪真正的大文件（>1MB），不跟踪源代码和配置文件

# =========================
# 机器学习模型文件
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
# 视频文件
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
# 音频文件
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.aac filter=lfs diff=lfs merge=lfs -text
# 图像序列与高分辨率图像
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
# 编译产物与二进制文件
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
# 归档文件
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
# 数据文件
*.npz filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
# 注意：3D 文件（.ply, .obj, .glb, .gltf 等）不追踪，由 .gitignore 处理
# 原因：3DGS 训练生成的 .ply 文件通常是临时文件，不需要版本控制
# 项目特定路径（模型文件）
ai_engine/**/*.pt filter=lfs diff=lfs merge=lfs -text
ai_engine/**/*.pth filter=lfs diff=lfs merge=lfs -text
ai_engine/**/*.ckpt filter=lfs diff=lfs merge=lfs -text
# 第三方库特定文件
/ai_engine/3dgs/src/libs/ml-sharp/ACKNOWLEDGEMENTS filter=lfs diff=lfs merge=lfs -text
/ai_engine/3dgs/src/libs/ml-sharp/LICENSE filter=lfs diff=lfs merge=lfs -text
/ai_engine/3dgs/src/libs/ml-sharp/LICENSE_MODEL filter=lfs diff=lfs merge=lfs -text
/ai_engine/3dgs/src/libs/sam-3d-objects/LICENSE filter=lfs diff=lfs merge=lfs -text
/ai_engine/3dgs/src/libs/sam-3d-objects/patching/hydra filter=lfs diff=lfs merge=lfs -text
*.py:*.md:*.txt:*.json:*.yaml:*.yml:*.toml:*.sh:*.ini:*.in:*.lock:*.log:*.id:*.cfg:*.conf:*.config !text -filter -merge -diff
*.py !text !filter !merge !diff
*.md !text !filter !merge !diff
*.txt !text !filter !merge !diff
*.json !text !filter !merge !diff
*.yaml !text !filter !merge !diff
*.yml !text !filter !merge !diff
*.toml !text !filter !merge !diff
*.sh !text !filter !merge !diff
