SUPABASE_URL=YOUR_SUPABASE_URL
# 可选：为本地开发提供多个候选地址，逗号分隔。
# 例如真机调试时，常见组合为：
# SUPABASE_URL_FALLBACKS=http://192.168.25.189:54321,http://10.0.2.2:54321,http://127.0.0.1:54321

# 方式 1：普通客户端模式（走 RLS）
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 方式 2：统一配置，anon / secret 都可填
# anon key -> 仍走 RLS
# secret key -> 进入管理员模式，绕过 RLS 读取全部模型/任务
SUPABASE_KEY=YOUR_SUPABASE_KEY

# 高德 Web 服务 Key，用于社区页静态地图。
# 也可以使用 AMAP_KEY；优先读取 AMAP_WEB_SERVICE_KEY。
AMAP_WEB_SERVICE_KEY=YOUR_AMAP_WEB_SERVICE_KEY

# 端侧 GGUF 默认下载地址。
# 不填时会自动回退到：
# {SUPABASE_URL}/storage/v1/object/public/braindance-models/releases/qwen3-1.7b-braindance-q5-k-m-imatrix.gguf
# LOCAL_LLM_MODEL_URL=

# 如需在同一 Supabase 项目内切换模型对象，可只覆盖 bucket / path。
# LOCAL_LLM_MODEL_BUCKET=braindance-models
# LOCAL_LLM_MODEL_OBJECT_PATH=releases/qwen3-1.7b-braindance-q5-k-m-imatrix.gguf
